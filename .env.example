# Flutter does NOT load this file at runtime — it exists only so every app's
# required configuration is documented in the conventional `.env.example`
# location. The actual mechanism is --dart-define-from-file, per
# docs/ARCHITECTURE.md §31.12 (these are non-secret public API endpoints, so
# baking them in per build is simpler and more idiomatic Flutter than
# shipping a dotenv file inside the compiled app package).
#
# Real config lives in:
#   env/dev.json       (used by: flutter run --dart-define-from-file=env/dev.json)
#   env/staging.json
#   env/prod.json
#
# Required variables (see mobile/lib/core/config/app_config.dart):

# ENV_NAME: development | staging | production
ENV_NAME=development

# API_BASE_URL: base URL of the backend API (already versioned)
API_BASE_URL=http://localhost:3000/api/v1

# CURRICULUM_API_AVAILABLE: set to true once the backend ships the
# Curriculum endpoints (see mobile/CURRICULUM_API_REQUIREMENTS.md). Defaults
# to false, which uses in-app sample data instead — never real, never
# production-ready.
CURRICULUM_API_AVAILABLE=false

# STUDY_SESSION_API_AVAILABLE: set to true once the backend ships the Study
# Session / Question Bank endpoints (see
# mobile/STUDY_SESSION_API_REQUIREMENTS.md). Defaults to false, which uses
# in-app sample questions instead — never real, never production-ready.
STUDY_SESSION_API_AVAILABLE=false

# EXAM_SIMULATION_API_AVAILABLE: set to true once the backend ships the Exam
# Simulation endpoints (see mobile/EXAM_SIMULATION_API_REQUIREMENTS.md).
# Defaults to false, which uses in-app mock exam data instead — never real,
# never production-ready.
EXAM_SIMULATION_API_AVAILABLE=false
